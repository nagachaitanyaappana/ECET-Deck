# Copy this file to .env in the repository root.
# Replace the placeholders with your Supabase Session Pooler details.
# Never commit the real .env file or share its password.

DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
DB_USERNAME=YOUR_SUPABASE_POOLER_USERNAME
DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# Generate a unique 32-byte secret locally and Base64-encode it.
JWT_SECRET_BASE64=REPLACE_WITH_RANDOM_BASE64_SECRET
JWT_ACCESS_TOKEN_MINUTES=720

# Optional first-admin bootstrap. Configure these only for the first startup.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
BOOTSTRAP_ADMIN_NAME=ECET Desk Admin


# Optional AI question generation. Obtain a key from OpenRouter.
# Keep the real key only in your ignored local .env file.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
